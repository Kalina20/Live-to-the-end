  m_EditorClassIdentifier: Assembly-CSharp::QuestionSet
  monthName: April
  stackNumber: 1
  questions:
  - questionText: "\u041A\u043E\u043C\u0435\u043D\u0434\u0430\u043D\u0442 \u043E\u0431\u0449\u0430\u0433\u0438
      \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u0431\u0445\u043E\u0434\u0430
      \u043D\u0430\u0448\u043B\u0430 \u0443 \u0432\u0430\u0441 \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043D\u044B\u0439
      \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0447\u0430\u0439\u043D\u0438\u043A
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435. \u041F\u043E\u043E\u0431\u0435\u0449\u0430\u043B\u0430
      \u0432\u044B\u0441\u0435\u043B\u0438\u0442\u044C."
    answers:
    - answerText: "\u041E\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
        \u0448\u0442\u0440\u0430\u0444"
      knowledgeChange: 0
      friendshipChange: 0
      moneyChange: -3000
    - answerText: "\u041E\u0442\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C
        \u0443\u0431\u043E\u0440\u043A\u043E\u0439 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438"
      knowledgeChange: -10
      friendshipChange: -15
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u041D\u0430 \u043D\u043E\u0441\u0443 \u0441\u0434\u0430\u0447\u0430
      \u0418\u0417 \u043F\u043E \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F,
      \u043D\u043E \u0432\u0430\u0448 \u0436\u0435\u0441\u0442\u043A\u0438\u0439
      \u0434\u0438\u0441\u043A \u043D\u0430 \u043D\u043E\u0443\u0442\u0435 \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0443\u043C\u0435\u0440."
    answers:
    - answerText: "\u041A\u0443\u043F\u0438\u0442\u044C \u043D\u043E\u0432\u044B\u0439
        SSD \u0434\u0438\u0441\u043A"
      knowledgeChange: 5
      friendshipChange: 0
      moneyChange: -5000
    - answerText: "\u0418\u0441\u043A\u0430\u0442\u044C \u0441\u0442\u0430\u0440\u044B\u0439
        \u041F\u041A \u0443 \u0434\u0440\u0443\u0437\u0435\u0439"
      knowledgeChange: -10
      friendshipChange: -15
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u041E\u0434\u043D\u043E\u0433\u0440\u0443\u043F\u043F\u043D\u0438\u043A\u0438
      \u0437\u043E\u0432\u0443\u0442 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C
      \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443 \u0432\u0435\u0441\u043D\u044B
      \u043D\u0430 \u0448\u0430\u0448\u043B\u044B\u043A\u0430\u0445, \u043D\u043E
      \u0432\u044B \u043E\u0431\u0435\u0449\u0430\u043B\u0438 \u043F\u043E\u043C\u043E\u0447\u044C
      \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C."
    answers:
    - answerText: "\u041E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C
        \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C"
      knowledgeChange: 0
      friendshipChange: -20
      moneyChange: 2000
    - answerText: "\u041F\u043E\u0435\u0445\u0430\u0442\u044C \u043D\u0430 \u0448\u0430\u0448\u043B\u044B\u043A\u0438"
      knowledgeChange: -5
      friendshipChange: 20
      moneyChange: -3000
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0412\u044B \u043E\u043F\u043E\u0437\u0434\u0430\u043B\u0438
      \u043D\u0430 \u0432\u0430\u0436\u043D\u0443\u044E \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0443\u044E
      \u0440\u0430\u0431\u043E\u0442\u0443, \u0438 \u043F\u0440\u0435\u043F\u043E\u0434
      \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B \u0432\u0430\u0441 \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C
      \u0435\u0451 \u043F\u0435\u0440\u0435\u0434 \u0432\u0441\u0435\u0439 \u043A\u0430\u0444\u0435\u0434\u0440\u043E\u0439."
    answers:
    - answerText: "\u0411\u043E\u0442\u0430\u0442\u044C \u0432\u0441\u044E \u043D\u043E\u0447\u044C
        \u043A \u0437\u0430\u0449\u0438\u0442\u0435"
      knowledgeChange: 20
      friendshipChange: -10
      moneyChange: 0
    - answerText: "\u0418\u0434\u0442\u0438 \u043D\u0435\u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u043C
        (\u043D\u0430 3)"
      knowledgeChange: -15
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
