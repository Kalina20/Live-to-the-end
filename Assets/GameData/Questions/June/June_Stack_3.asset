  m_Script: {fileID: 11500000, guid: 5e5612d4c1ab8054f975222f7e4b0a9b, type: 3}
  m_Name: June_Stack_3
  m_EditorClassIdentifier: Assembly-CSharp::QuestionSet
  monthName: June
  stackNumber: 3
  questions:
  - questionText: "\u0412\u044B \u0437\u0430\u043F\u0443\u0442\u0430\u043B\u0438\u0441\u044C
      \u0432 \u0431\u0438\u043B\u0435\u0442\u0430\u0445 \u043F\u043E \u0441\u0435\u0442\u044F\u043C
      \u043F\u0440\u044F\u043C\u043E \u043F\u0435\u0440\u0435\u0434 \u0434\u0432\u0435\u0440\u044C\u044E
      \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438."
    answers:
    - answerText: "\u0414\u0440\u0443\u0433 \u043E\u0442\u0434\u0430\u0435\u0442
        \u0441\u0432\u043E\u0439 \u043C\u0438\u043A\u0440\u043E\u043D\u0430\u0443\u0448\u043D\u0438\u043A
        \u0441\u043E \u0448\u043F\u043E\u0440\u043E\u0439."
      knowledgeChange: 15
      friendshipChange: 10
      moneyChange: 0
    - answerText: "\u0418\u0434\u0435\u0442\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C
        \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E
        \u0432\u044B\u0443\u0447\u0438\u043B\u0438."
      knowledgeChange: -10
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 2
    checkThreshold: 50
  - questionText: "\u041E\u0434\u043D\u043E\u0433\u0440\u0443\u043F\u043F\u043D\u0438\u043A\u0438
      \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u044E\u0442 \u0432\u044B\u043F\u0443\u0441\u043A\u043D\u043E\u0439
      \u0441\u0430\u0431\u0430\u043D\u0442\u0443\u0439 \u0441 \u0430\u0440\u0435\u043D\u0434\u043E\u0439
      \u043A\u043E\u0442\u0442\u0435\u0434\u0436\u0430."
    answers:
    - answerText: "\u041E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0435
        \u0432\u0437\u043D\u043E\u0441 \u0431\u0435\u0437 \u0443\u0449\u0435\u0440\u0431\u0430
        \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0443."
      knowledgeChange: 0
      friendshipChange: 25
      moneyChange: -5000
    - answerText: "\u041E\u0441\u0442\u0430\u0435\u0442\u0435\u0441\u044C \u043E\u0434\u0438\u043D
        \u0432 \u043E\u0431\u0449\u0430\u0433\u0435, \u043F\u043E\u043A\u0430 \u0432\u0441\u0435
        \u0442\u0443\u0441\u044F\u0442."
      knowledgeChange: 0
      friendshipChange: -20
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 3
    checkThreshold: 15000
  - questionText: "\u0421\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0438\u0439 \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u043F\u043E \u0441\u0445\u0435\u043C\u043E\u0442\u0435\u0445\u043D\u0438\u043A\u0435
      \u0443 \u0441\u0430\u043C\u043E\u0433\u043E \u0436\u0435\u0441\u0442\u043A\u043E\u0433\u043E
      \u043F\u0440\u0435\u043F\u043E\u0434\u0430."
    answers:
    - answerText: "\u041F\u043E\u0440\u0430\u0436\u0430\u0435\u0442\u0435 \u043F\u0440\u0435\u043F\u043E\u0434\u0430
        \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438, \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435
        5."
      knowledgeChange: 30
      friendshipChange: 0
      moneyChange: 0
    - answerText: "\u041E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B \u043D\u0430
        \u043F\u0435\u0440\u0435\u0441\u0434\u0430\u0447\u0443 \u0434\u043E \u043E\u0441\u0435\u043D\u0438."
      knowledgeChange: -20
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 1
    checkThreshold: 65
  - questionText: "\u0413\u0440\u0443\u043F\u043F\u0430 \u0440\u0435\u0448\u0430\u0435\u0442,
      \u043A\u043E\u0433\u043E \u0432\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044C
      \u043D\u0430 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u043E\u0439
      \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u0440\u0435\u043C\u0438\u0438."
    answers:
    - answerText: "\u041F\u043E\u0442\u043E\u043A \u0434\u0440\u0443\u0436\u043D\u043E
        \u0433\u043E\u043B\u043E\u0441\u0443\u0435\u0442 \u0437\u0430 \u0432\u0430\u0448\u0443
        \u043A\u0430\u043D\u0434\u0438\u0434\u0430\u0442\u0443\u0440\u0443."
      knowledgeChange: 0
      friendshipChange: 20
      moneyChange: 5000
    - answerText: "\u0412\u044B\u0434\u0432\u0438\u0433\u0430\u044E\u0442 \u0434\u0440\u0443\u0433\u043E\u0433\u043E,
        \u0432\u044B \u043E\u0441\u0442\u0430\u0435\u0442\u0435\u0441\u044C \u0432
        \u0442\u0435\u043D\u0438."
      knowledgeChange: 0
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 2
    checkThreshold: 55
