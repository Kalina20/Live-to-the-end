  questions:
  - questionText: "\u0412 \u0441\u0435\u0442\u0438 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u0441\u043B\u0438\u0432 \u043E\u0442\u0432\u0435\u0442\u043E\u0432 \u043D\u0430
      \u0441\u043B\u043E\u0436\u043D\u0435\u0439\u0448\u0438\u0439 \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u043F\u043E \u0441\u0435\u0442\u044F\u043C. \u0426\u0435\u043D\u0430 \u043A\u0443\u0441\u0430\u0435\u0442\u0441\u044F,
      \u043D\u043E \u0440\u0438\u0441\u043A \u0432\u044B\u043B\u0435\u0442\u0435\u0442\u044C
      \u0432\u0435\u043B\u0438\u043A."
    answers:
    - answerText: "\u0421\u043A\u0438\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0430
        \u043E\u0442\u0432\u0435\u0442\u044B"
      knowledgeChange: -10
      friendshipChange: 15
      moneyChange: -2000
    - answerText: "\u0417\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0441\u0430\u043C\u043E\u043C\u0443"
      knowledgeChange: 20
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0421\u0435\u0441\u0441\u0438\u044F \u0437\u0430\u043A\u0440\u044B\u0442\u0430!
      \u0413\u0440\u0430\u043D\u0434\u0438\u043E\u0437\u043D\u0430\u044F \u0442\u0443\u0441\u043E\u0432\u043A\u0430
      \u0432 \u0447\u0435\u0441\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043A\u0443\u0440\u0441\u0430 \u0438
      \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0435."
    answers:
    - answerText: "\u0413\u0443\u043B\u044F\u0442\u044C \u043D\u0430 \u0432\u0441\u0435
        \u0434\u0435\u043D\u044C\u0433\u0438"
      knowledgeChange: -5
      friendshipChange: 25
      moneyChange: -5000
    - answerText: "\u041F\u043E\u0439\u0442\u0438 \u0441\u043F\u0430\u0442\u044C"
      knowledgeChange: 5
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u041B\u0435\u0442\u043D\u0438\u0439 \u0433\u0435\u0439\u043C\u0434\u0435\u0432-\u0445\u0430\u043A\u0430\u0442\u043E\u043D.
      \u041C\u043E\u0436\u043D\u043E \u0437\u0430\u043F\u0438\u043B\u0438\u0442\u044C
      \u0438\u0433\u0440\u0443 \u043D\u0430 Unity \u0438 \u0441\u043E\u0440\u0432\u0430\u0442\u044C
      \u043F\u0440\u0438\u0437\u043E\u0432\u043E\u0439 \u0444\u043E\u043D\u0434."
    answers:
    - answerText: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u0443"
      knowledgeChange: 20
      friendshipChange: 15
      moneyChange: -1000
    - answerText: "\u041F\u0440\u043E\u0441\u0442\u043E \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C"
