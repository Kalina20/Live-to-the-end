  questions:
  - questionText: "\u0417\u0430\u0447\u0435\u0442\u043D\u0430\u044F \u043D\u0435\u0434\u0435\u043B\u044F
      \u0433\u043E\u0440\u0438\u0442. \u0421\u043E\u0441\u0435\u0434 \u043F\u043E
      \u043E\u0431\u0449\u0430\u0433\u0435 \u0432\u0440\u0443\u0431\u0438\u043B \u043C\u0443\u0437\u044B\u043A\u0443
      \u043D\u0430 \u0432\u0441\u044E \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C
      \u0438 \u043F\u0440\u0430\u0437\u0434\u043D\u0443\u0435\u0442 \u0434\u0435\u043D\u044C
      \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F."
    answers:
    - answerText: "\u0423\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0441\u043A\u0430\u043D\u0434\u0430\u043B"
      knowledgeChange: 15
      friendshipChange: -20
      moneyChange: 0
    - answerText: "\u041F\u043E\u0439\u0442\u0438 \u043F\u0440\u0430\u0437\u0434\u043D\u043E\u0432\u0430\u0442\u044C
        \u0441 \u043D\u0438\u043C"
      knowledgeChange: -20
      friendshipChange: 15
      moneyChange: -2000
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0412\u044B \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438
      \u0441\u0434\u0430\u0442\u044C \u043A\u0443\u0440\u0441\u043E\u0432\u043E\u0439
      \u043F\u0440\u043E\u0435\u043A\u0442 \u043F\u043E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F\u043C \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u0434\u0435\u0434\u043B\u0430\u0439\u043D."
    answers:
    - answerText: "\u041A\u0443\u043F\u0438\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u044B\u0439
        \u043F\u0440\u043E\u0435\u043A\u0442"
      knowledgeChange: -20
      friendshipChange: 0
      moneyChange: -5000
    - answerText: "\u041F\u0440\u043E\u0441\u0438\u0442\u044C \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0443
        (\u043C\u0438\u043D\u0443\u0441 \u0431\u0430\u043B\u043B\u044B)"
      knowledgeChange: 10
      friendshipChange: -5
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u041F\u0435\u0440\u0435\u0434 \u041D\u043E\u0432\u044B\u043C
      \u0433\u043E\u0434\u043E\u043C \u0432\u044B \u0441\u0438\u043B\u044C\u043D\u043E
      \u043F\u0440\u043E\u0441\u0442\u0443\u0434\u0438\u043B\u0438\u0441\u044C. \u041F\u0440\u043E\u0435\u043A\u0442\u044B
      \u0433\u043E\u0440\u044F\u0442, \u0433\u043E\u043B\u043E\u0432\u0430 \u043D\u0435
      \u0441\u043E\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442."
    answers:
    - answerText: "\u041A\u0443\u043F\u0438\u0442\u044C \u043A\u0443\u0447\u0443
        \u0430\u043D\u0442\u0438\u0431\u0438\u043E\u0442\u0438\u043A\u043E\u0432"
      knowledgeChange: 5
      friendshipChange: 0
      moneyChange: -2500
    - answerText: "\u041F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043A\u043E\u0434\u0438\u0442\u044C
        \u0441 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u043E\u0439"
      knowledgeChange: -20
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0421\u0442\u0430\u0440\u043E\u0441\u0442\u0430 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442
      \u0448\u0442\u0440\u0430\u0444\u043D\u043E\u0439 \u0444\u043E\u043D\u0434 \u0441
      \u0442\u0435\u0445, \u043A\u0442\u043E \u043D\u0435 \u0434\u0435\u0436\u0443\u0440\u0438\u043B
      \u0432 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0438 \u0432\u043E
      \u0432\u0440\u0435\u043C\u044F \u0441\u0435\u043C\u0435\u0441\u0442\u0440\u0430."
    answers:
    - answerText: "\u0421\u0434\u0430\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438
        \u0432 \u0444\u043E\u043D\u0434"
      knowledgeChange: 0
      friendshipChange: 10
      moneyChange: -1500
    - answerText: "\u041F\u043E\u0439\u0442\u0438 \u043D\u0430 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442
        \u0441 \u0433\u0440\u0443\u043F\u043F\u043E\u0439"
