      moneyChange: -1000
    - answerText: "\u0411\u043E\u0442\u0430\u0442\u044C \u043A \u0420\u041A1"
      knowledgeChange: 20
      friendshipChange: -5
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0422\u044F\u0436\u0435\u043B\u044B\u0439 \u0434\u0435\u043D\u044C
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u043E\u0432.
      \u0412 \u043E\u0431\u0449\u0430\u0433\u0435 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E\u0442
      \u0441\u043A\u0438\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0443
      \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0439 \u043F\u0438\u0446\u0446\u044B."
    answers:
    - answerText: "\u0421\u043A\u0438\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0430
        \u0435\u0434\u0443"
      knowledgeChange: 0
      friendshipChange: 10
      moneyChange: -500
    - answerText: "\u0415\u0441\u0442\u044C \u0441\u0432\u043E\u0438 \u043C\u0430\u043A\u0430\u0440\u043E\u043D\u044B"
      knowledgeChange: 0
      friendshipChange: -5
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u041F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u043E\u0442\u043B\u0438\u0447\u043D\u0430\u044F
      \u043F\u043E\u0434\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u043D\u0430 \u0432\u0435\u0447\u0435\u0440
      \u2014 \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      CI/CD \u043F\u0430\u0439\u043F\u043B\u0430\u0439\u043D \u0434\u043B\u044F \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
