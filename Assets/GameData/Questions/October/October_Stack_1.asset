    checkThreshold: 0
  - questionText: "\u0422\u0435\u043F\u043B\u0430\u044F \u043E\u0441\u0435\u043D\u044C.
      \u0414\u0440\u0443\u0437\u044C\u044F \u0437\u043E\u0432\u0443\u0442 \u0432\u0437\u044F\u0442\u044C
      \u0441\u0430\u043C\u043E\u043A\u0430\u0442\u044B \u0438 \u043F\u043E\u043A\u0430\u0442\u0430\u0442\u044C\u0441\u044F
      \u0442\u043E\u043B\u043F\u043E\u0439 \u043F\u043E \u043D\u0430\u0431\u0435\u0440\u0435\u0436\u043D\u043E\u0439
