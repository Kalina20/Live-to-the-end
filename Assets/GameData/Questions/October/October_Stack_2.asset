  m_Script: {fileID: 11500000, guid: 5e5612d4c1ab8054f975222f7e4b0a9b, type: 3}
  m_Name: October_Stack_2
  m_EditorClassIdentifier: Assembly-CSharp::QuestionSet
  monthName: October
  stackNumber: 2
  questions:
  - questionText: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0438
      \u043A\u0440\u0443\u043F\u043D\u0430\u044F \u0440\u0430\u0441\u043F\u0440\u043E\u0434\u0430\u0436\u0430
      \u0431/\u0443 \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u043E\u0432."
    answers:
    - answerText: "\u041F\u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0435 \u0432\u0442\u043E\u0440\u043E\u0439
        \u043C\u043E\u043D\u0438\u0442\u043E\u0440, \u043A\u043E\u0434\u0438\u0442\u044C
        \u0443\u0434\u043E\u0431\u043D\u0435\u0435."
      knowledgeChange: 20
      friendshipChange: 0
      moneyChange: -8000
    - answerText: "\u041E\u0441\u0442\u0430\u0435\u0442\u0435\u0441\u044C \u0441
        \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C \u044D\u043A\u0440\u0430\u043D\u043E\u043C
        \u043D\u043E\u0443\u0442\u0431\u0443\u043A\u0430."
      knowledgeChange: -5
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 3
    checkThreshold: 15000
  - questionText: "\u0420\u0443\u0431\u0435\u0436\u043D\u044B\u0439 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
      (\u0420\u041A1) \u043F\u043E \u0434\u0438\u0441\u043A\u0440\u0435\u0442\u043D\u043E\u0439
      \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435. \u0421\u043F\u0438\u0441\u0430\u0442\u044C
      \u043D\u0435\u0440\u0435\u0430\u043B\u044C\u043D\u043E."
    answers:
    - answerText: "\u0421\u0434\u0430\u0435\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
        \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0440\u0430\u0437\u0430
        \u043D\u0430 \u043C\u0430\u043A\u0441 \u0431\u0430\u043B\u043B."
      knowledgeChange: 15
      friendshipChange: 0
      moneyChange: 0
    - answerText: "\u0417\u0430\u0432\u0430\u043B\u0438\u043B\u0438 \u0420\u041A,
        \u0442\u0440\u0430\u0442\u0438\u0442\u0435 \u043A\u044D\u0448 \u043D\u0430
        \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043A\u0438."
      knowledgeChange: -10
      friendshipChange: 0
      moneyChange: -1500
    isCheckEvent: 1
    statToCheck: 1
    checkThreshold: 25
  - questionText: "\u0412 \u0413\u0417 \u0411\u0430\u0443\u043C\u0430\u043D\u043A\u0438
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0441\u044F \u0432\u0430\u0448 \u043F\u0440\u043E\u043F\u0443\u0441\u043A.
      \u041D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0432\u043D\u0443\u0442\u0440\u044C."
    answers:
    - answerText: "\u041E\u0434\u043D\u043E\u0433\u0440\u0443\u043F\u043F\u043D\u0438\u043A
        \u0432\u044B\u043D\u043E\u0441\u0438\u0442 \u0441\u0432\u043E\u0439 \u0438
        \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u0432\u0430\u0441."
      knowledgeChange: 0
      friendshipChange: 10
      moneyChange: 0
    - answerText: "\u041F\u043B\u0430\u0442\u0438\u0442\u0435 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
        \u0448\u0442\u0440\u0430\u0444 \u0437\u0430 \u0443\u0442\u0435\u0440\u044E."
      knowledgeChange: 0
      friendshipChange: -5
      moneyChange: -1000
    isCheckEvent: 1
    statToCheck: 2
    checkThreshold: 25
  - questionText: "\u041F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u043E\u0442\u0431\u043E\u0440
      \u043D\u0430 \u0444\u0430\u043A\u0443\u043B\u044C\u0442\u0430\u0442\u0438\u0432
      \u043F\u043E \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u043E\u0439
      \u0432\u0435\u0431-\u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0435."
    answers:
    - answerText: "\u0412\u0430\u0441 \u0437\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442
        \u043D\u0430 \u043A\u0443\u0440\u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
        \u0437\u043D\u0430\u043D\u0438\u044F\u043C."
      knowledgeChange: 20
      friendshipChange: 0
      moneyChange: 0
    - answerText: "\u041D\u0435 \u043F\u0440\u043E\u0448\u043B\u0438 \u0432\u0445\u043E\u0434\u043D\u043E\u0435
        \u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435."
      knowledgeChange: -10
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 1
    checkThreshold: 30
