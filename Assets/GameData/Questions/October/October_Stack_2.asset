  questions:
  - questionText: "\u0413\u0440\u0443\u043F\u043F\u0430 \u043C\u0430\u0441\u0441\u043E\u0432\u043E
      \u0440\u0435\u0448\u0438\u043B\u0430 \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u0442\u044C
      \u0441\u043A\u0443\u0447\u043D\u0443\u044E \u043B\u0435\u043A\u0446\u0438\u044E
      \u043F\u043E \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0435. \u0421\u0442\u0430\u0440\u043E\u0441\u0442\u0430
      \u043F\u0440\u043E\u0441\u0438\u0442 \u0432\u0430\u0441 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u0431\u043E\u0439\u043A\u043E\u0442, \u043D\u043E \u043F\u0440\u0435\u043F\u043E\u0434
      \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442 \u043F\u043E \u0441\u043F\u0438\u0441\u043A\u0443."
    answers:
    - answerText: "\u041F\u0440\u043E\u0433\u0443\u043B\u044F\u0442\u044C \u0441\u043E
        \u0432\u0441\u0435\u043C\u0438"
      knowledgeChange: -15
      friendshipChange: 15
      moneyChange: 0
    - answerText: "\u041F\u043E\u0439\u0442\u0438 \u043D\u0430 \u043B\u0435\u043A\u0446\u0438\u044E
        \u043E\u0434\u043D\u043E\u043C\u0443"
      knowledgeChange: 15
      friendshipChange: -20
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0418\u0437-\u0437\u0430 \u043D\u0435\u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u0432 Git \u0432\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438 git push
      --force \u0432 \u043E\u0431\u0449\u0443\u044E \u0432\u0435\u0442\u043A\u0443
      \u0438 \u0437\u0430\u0442\u0435\u0440\u043B\u0438 \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u044E\u044E
      \u0440\u0430\u0431\u043E\u0442\u0443 \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0430."
    answers:
    - answerText: "\u041D\u043E\u0447\u044C\u044E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
        \u043A\u043E\u0434"
      knowledgeChange: -15
      friendshipChange: 10
      moneyChange: 0
    - answerText: "\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u044C\u0441\u044F \u0438
        \u043B\u0435\u0447\u044C \u0441\u043F\u0430\u0442\u044C"
      knowledgeChange: 0
      friendshipChange: -20
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u041D\u0430 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0435
      \u0432 \u0441\u043F\u043E\u0440\u0442\u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0435
      \u0411\u0430\u0443\u043C\u0430\u043D\u043A\u0438 \u0432\u044B \u0441\u0438\u043B\u044C\u043D\u043E
      \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u0438 \u0441\u043F\u0438\u043D\u0443.
      \u041D\u0443\u0436\u043D\u044B \u043C\u0430\u0437\u0438 \u0438 \u043E\u0431\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435."
    answers:
    - answerText: "\u041A\u0443\u043F\u0438\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0438\u0435
        \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430"
      knowledgeChange: 0
      friendshipChange: 0
      moneyChange: -3000
    - answerText: "\u0422\u0435\u0440\u043F\u0435\u0442\u044C \u0431\u043E\u043B\u044C
        \u043D\u0430 \u043F\u0430\u0440\u0430\u0445"
      knowledgeChange: -10
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0412\u044B \u0437\u0430\u0431\u044B\u043B\u0438 \u043F\u0440\u043E\u0434\u043B\u0438\u0442\u044C
      \u043B\u044C\u0433\u043E\u0442\u043D\u044B\u0439 \u043F\u0440\u043E\u0435\u0437\u0434\u043D\u043E\u0439,
      \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u0440\u044B \u0432
      \u043C\u0435\u0442\u0440\u043E \u0432\u044B\u043F\u0438\u0441\u0430\u043B\u0438
      \u0432\u0430\u043C \u043A\u0440\u0443\u043F\u043D\u044B\u0439 \u0448\u0442\u0440\u0430\u0444."
    answers:
    - answerText: "\u041E\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0448\u0442\u0440\u0430\u0444
        \u0441\u0440\u0430\u0437\u0443"
      knowledgeChange: 0
      friendshipChange: 0
      moneyChange: -2500
    - answerText: "\u041F\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u0437\u0430\u0439\u043C\u044B
        \u0443 \u0433\u0440\u0443\u043F\u043F\u044B"
      knowledgeChange: 0
      friendshipChange: -15
      moneyChange: -1000
