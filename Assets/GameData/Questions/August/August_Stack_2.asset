  m_Script: {fileID: 11500000, guid: 5e5612d4c1ab8054f975222f7e4b0a9b, type: 3}
  m_Name: August_Stack_2
  m_EditorClassIdentifier: Assembly-CSharp::QuestionSet
  monthName: August
  stackNumber: 2
  questions:
  - questionText: "\u041A\u043E\u043C\u0435\u043D\u0434\u0430\u043D\u0442 \u043E\u0431\u0449\u0430\u0433\u0438
      \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0437\u0430\u043B\u043E\u0433 \u0437\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0433\u043E\u0434."
    answers:
    - answerText: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0432\u043D\u043E\u0441\u0438\u0442\u0435
        \u0441\u0443\u043C\u043C\u0443, \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F
        \u0436\u0438\u043B\u044C\u0435."
      knowledgeChange: 0
      friendshipChange: 0
      moneyChange: -10000
    - answerText: "\u0421\u0440\u043E\u0447\u043D\u043E \u0438\u0449\u0435\u0442\u0435
        \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B, \u0442\u0440\u0430\u0442\u0438\u0442\u0435
        \u043D\u0435\u0440\u0432\u044B."
      knowledgeChange: -5
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 3
    checkThreshold: 25000
  - questionText: "\u041E\u0442\u0431\u043E\u0440 \u043B\u0443\u0447\u0448\u0438\u0445
      \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432 \u043A\u0443\u0440\u0441\u0430
      \u0432 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0439 R&D \u043F\u0440\u043E\u0435\u043A\u0442
      \u0441 \u0431\u0443\u0434\u0443\u0449\u0435\u0439 \u0417\u041F."
    answers:
    - answerText: "\u0412\u0430\u0441 \u0431\u0435\u0440\u0443\u0442 \u0432 \u043A\u043E\u043C\u0430\u043D\u0434\u0443
        \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u043E\u0432."
      knowledgeChange: 15
      friendshipChange: 0
      moneyChange: 15000
    - answerText: "\u041D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u043D\u0430\u0432\u044B\u043A\u043E\u0432,
        \u0431\u0435\u0440\u0443\u0442 \u043E\u0434\u043D\u043E\u0433\u0440\u0443\u043F\u043F\u043D\u0438\u043A\u0430."
      knowledgeChange: -10
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 1
    checkThreshold: 65
  - questionText: "\u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0435\u0442\u0441\u044F
      \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u0439 \u043B\u0435\u0442\u043D\u0438\u0439
      \u0441\u0431\u043E\u0440 \u0431\u0430\u0443\u043C\u0430\u043D\u0446\u0435\u0432
      \u043D\u0430 \u043F\u0440\u0438\u0440\u043E\u0434\u0435."
    answers:
    - answerText: "\u0412\u044B \u0435\u0434\u0435\u0442\u0435 \u0433\u043B\u0430\u0432\u043D\u044B\u043C
        \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u043E\u043C,
        \u043C\u0430\u043A\u0441 \u0440\u0435\u0441\u043F\u0435\u043A\u0442."
      knowledgeChange: 0
      friendshipChange: 30
      moneyChange: -2000
    - answerText: "\u0412\u0430\u0441 \u0437\u0430\u0431\u044B\u043B\u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u0442\u044C,
        \u0441\u0438\u0434\u0438\u0442\u0435 \u0434\u043E\u043C\u0430."
      knowledgeChange: 0
      friendshipChange: -20
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 2
    checkThreshold: 60
  - questionText: "\u041F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0448\u0430\u043D\u0441
      \u0432\u044B\u043A\u0443\u043F\u0438\u0442\u044C \u0443\u0435\u0437\u0436\u0430\u044E\u0449\u0435\u0433\u043E
      \u0441\u0442\u0430\u0440\u0448\u0435\u043A\u0443\u0440\u0441\u043D\u0438\u043A\u0430
      \u043C\u0435\u0441\u0442\u043E \u0432 \u043A\u0440\u0443\u0442\u043E\u0439
      \u0430\u0432\u0442\u043E\u0448\u043A\u043E\u043B\u0435 \u0441\u043E \u0441\u043A\u0438\u0434\u043A\u043E\u0439."
    answers:
    - answerText: "\u0417\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C
        \u043D\u0430 \u043A\u0443\u0440\u0441\u044B \u0432\u043E\u0436\u0434\u0435\u043D\u0438\u044F."
      knowledgeChange: 10
      friendshipChange: 5
      moneyChange: -15000
    - answerText: "\u0423\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0435 \u0448\u0430\u043D\u0441,
        \u0430\u0432\u0442\u043E\u0448\u043A\u043E\u043B\u0430 \u0432\u044B\u0439\u0434\u0435\u0442
        \u0434\u043E\u0440\u043E\u0436\u0435."
      knowledgeChange: 0
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 3
    checkThreshold: 30000
