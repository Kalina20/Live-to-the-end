  - questionText: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0433\u0440\u0443\u043F\u043F\u044B
      \u0432 \u041C\u043E\u0441\u043A\u0432\u0435 \u043F\u0435\u0440\u0435\u0434
      \u043D\u0430\u0447\u0430\u043B\u043E\u043C \u0443\u0447\u0435\u0431\u044B.
      \u0412\u0441\u0435 \u0434\u0435\u043B\u044F\u0442\u0441\u044F \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u044F\u043C\u0438
      \u043E \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u043C \u043B\u0435\u0442\u0435."
    answers:
    - answerText: "\u041F\u043E\u0439\u0442\u0438 \u0432 \u0431\u0430\u0440"
      knowledgeChange: 0
      friendshipChange: 20
      moneyChange: -3000
    - answerText: "\u041A\u043E\u0434\u0438\u0442\u044C \u0434\u043E\u043C\u0430"
      knowledgeChange: 15
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0420\u0430\u0441\u043F\u0440\u043E\u0434\u0430\u0436\u0430 \u043C\u043E\u0449\u043D\u043E\u0439
