  m_Name: January_Stack_2
  m_EditorClassIdentifier: Assembly-CSharp::QuestionSet
  monthName: January
  stackNumber: 2
  questions:
  - questionText: "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430
      \u043F\u043E \u0444\u0438\u0437\u0438\u043A\u0435 \u0443 \u0432\u0430\u0441
      \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0435 \u0437\u0430\u0437\u0432\u043E\u043D\u0438\u043B
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D. \u041F\u0440\u0435\u043F\u043E\u0434
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u044D\u0442\u043E."
    answers:
    - answerText: "\u0421\u0434\u0430\u0442\u044C \u043F\u0443\u0441\u0442\u043E\u0439
        \u043B\u0438\u0441\u0442 \u0438 \u0443\u0439\u0442\u0438"
      knowledgeChange: -20
      friendshipChange: 0
      moneyChange: 0
    - answerText: "\u041F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043E\u043F\u0440\u0430\u0432\u0434\u0430\u0442\u044C\u0441\u044F"
      knowledgeChange: -10
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u041F\u043E\u0441\u043B\u0435 \u0442\u044F\u0436\u0435\u043B\u043E\u0433\u043E
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0430 \u0433\u0440\u0443\u043F\u043F\u0430
      \u0437\u043E\u0432\u0435\u0442 \u0432 \u043A\u0430\u0440\u0430\u043E\u043A\u0435,
      \u043D\u043E \u0437\u0430\u0432\u0442\u0440\u0430 \u0443\u0442\u0440\u043E\u043C
      \u2014 \u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u0446\u0438\u044F
      \u043F\u043E \u0441\u0430\u043C\u043E\u043C\u0443 \u0441\u043B\u043E\u0436\u043D\u043E\u043C\u0443
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0443."
    answers:
    - answerText: "\u041F\u043E\u0435\u0445\u0430\u0442\u044C \u0442\u0443\u0441\u0438\u0442\u044C
        \u0441 \u0433\u0440\u0443\u043F\u043F\u043E\u0439"
      knowledgeChange: -20
      friendshipChange: 20
      moneyChange: -4000
    - answerText: "\u041E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0443\u0447\u0438\u0442\u044C
        \u0431\u0438\u043B\u0435\u0442\u044B"
      knowledgeChange: 15
      friendshipChange: -15
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0412\u044B \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0438
      \u043F\u0435\u0440\u0432\u044B\u0439 \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u0441\u0435\u0441\u0441\u0438\u0438. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u043D\u0430 \u043D\u0443\u043B\u0435, \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F
      \u0440\u0443\u043A\u0438."
    answers:
    - answerText: "\u041F\u043E\u0435\u0445\u0430\u0442\u044C \u0434\u043E\u043C\u043E\u0439
        \u0437\u0430\u0435\u0434\u0430\u0442\u044C \u0441\u0442\u0440\u0435\u0441\u0441"
      knowledgeChange: -10
      friendshipChange: -10
      moneyChange: -3000
    - answerText: "\u0417\u0430\u043F\u0435\u0440\u0435\u0442\u044C\u0441\u044F \u0432
        \u043B\u0430\u0431\u0435 \u0438 \u0431\u043E\u0442\u0430\u0442\u044C"
      knowledgeChange: 20
      friendshipChange: -15
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0418\u0437-\u0437\u0430 \u0434\u043E\u043B\u0433\u0430 \u043F\u043E
      \u043E\u0434\u043D\u043E\u043C\u0443 \u0437\u0430\u0447\u0435\u0442\u0443 \u0432\u0430\u0441
      \u043D\u0435 \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442 \u043A
      \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C\u0443 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0443.
      \u041D\u0443\u0436\u043D\u043E \u0441\u0440\u043E\u0447\u043D\u043E \u0431\u0435\u0433\u0430\u0442\u044C
      \u0437\u0430 \u043F\u0440\u0435\u043F\u043E\u0434\u043E\u043C."
    answers:
    - answerText: "\u041F\u043E\u043A\u0443\u043F\u0430\u0442\u044C \u043F\u043E\u0434\u0430\u0440\u043E\u043A
        \u043F\u0440\u0435\u043F\u043E\u0434\u0443"
      knowledgeChange: 0
      friendshipChange: 0
      moneyChange: -3000
    - answerText: "\u0416\u0434\u0430\u0442\u044C \u043E\u0431\u0449\u0443\u044E
        \u043F\u0435\u0440\u0435\u0441\u0434\u0430\u0447\u0443"
      knowledgeChange: -15
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
