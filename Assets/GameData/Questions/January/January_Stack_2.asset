  m_Script: {fileID: 11500000, guid: 5e5612d4c1ab8054f975222f7e4b0a9b, type: 3}
  m_Name: January_Stack_2
  m_EditorClassIdentifier: Assembly-CSharp::QuestionSet
  monthName: January
  stackNumber: 2
  questions:
  - questionText: "\u0412\u044B \u0432 \u043F\u0430\u043D\u0438\u043A\u0435 \u043F\u0435\u0440\u0435\u0434
      \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u043E\u043C \u043F\u043E \u0444\u0438\u0437\u0438\u043A\u0435,
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u0432 \u043E\u043F\u0442\u0438\u043A\u0435."
    answers:
    - answerText: "\u041E\u0434\u043D\u043E\u0433\u0440\u0443\u043F\u043F\u043D\u0438\u043A\u0438
        \u0437\u0430 \u043D\u043E\u0447\u044C \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438
        \u0432\u0430\u043C \u043A\u0443\u0440\u0441."
      knowledgeChange: 20
      friendshipChange: 10
      moneyChange: 0
    - answerText: "\u041E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043E\u0434\u0438\u043D
        \u043D\u0430 \u043E\u0434\u0438\u043D \u0441 \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u043E\u043C."
      knowledgeChange: -15
      friendshipChange: -5
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 2
    checkThreshold: 35
  - questionText: "\u0421\u0440\u043E\u0447\u043D\u043E \u043D\u0443\u0436\u043D\u043E
      \u043F\u0440\u043E\u0434\u043B\u0438\u0442\u044C \u0445\u043E\u0441\u0442\u0438\u043D\u0433
      \u0434\u043B\u044F \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u043F\u043E \u0431\u0430\u0437\u0430\u043C
      \u0434\u0430\u043D\u043D\u044B\u0445."
    answers:
    - answerText: "\u041E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0435
        \u0434\u043E\u043B\u044E, \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430."
      knowledgeChange: 0
      friendshipChange: 15
      moneyChange: -2000
    - answerText: "\u041D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u043A\u0438\u043D\u0443\u0442\u044C\u0441\u044F,
        \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0438 \u0437\u043B\u044F\u0442\u0441\u044F."
      knowledgeChange: 0
      friendshipChange: -25
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 3
    checkThreshold: 8000
  - questionText: "\u042D\u043A\u0437\u0430\u043C\u0435\u043D \u043F\u043E \u043C\u0430\u0442\u0430\u043D\u0443.
      \u041F\u0440\u0435\u043F\u043E\u0434 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0441\u043B\u043E\u0436\u043D\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441
      \u043D\u0430 \u043E\u0442\u043B."
    answers:
    - answerText: "\u0412\u044B \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0435
        \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442\u0435 \u0438 \u0431\u0435\u0440\u0435\u0442\u0435
        \u043F\u044F\u0442\u0435\u0440\u043A\u0443."
      knowledgeChange: 25
      friendshipChange: 0
      moneyChange: 0
    - answerText: "\u0412\u044B \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u0438
        \u043E\u0442\u0432\u0435\u0442 \u0438 \u0441\u044A\u0435\u0445\u0430\u043B\u0438
        \u043D\u0430 \u0442\u0440\u043E\u0439\u043A\u0443."
      knowledgeChange: -15
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 1
    checkThreshold: 55
  - questionText: "\u0421\u043E\u0441\u0435\u0434 \u043F\u043E \u043E\u0431\u0449\u0430\u0433\u0435
      \u043F\u0440\u0430\u0437\u0434\u043D\u0443\u0435\u0442 \u0443\u0441\u043F\u0435\u0448\u043D\u0443\u044E
      \u0441\u0434\u0430\u0447\u0443 \u0441\u0435\u0441\u0441\u0438\u0438 \u0438
      \u043C\u0435\u0448\u0430\u0435\u0442 \u0432\u0430\u043C \u0441\u043F\u0430\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u0448\u0438\u043C \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u043E\u043C."
    answers:
    - answerText: "\u0412\u044B \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u0442\u0435
        \u0435\u0433\u043E, \u043E\u043D \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0435\u0442
        \u0437\u0432\u0443\u043A."
      knowledgeChange: 10
      friendshipChange: 5
      moneyChange: 0
    - answerText: "\u0423\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0435
        \u0434\u0440\u0430\u043A\u0443, \u043A\u043E\u043C\u0435\u043D\u0434\u0430\u043D\u0442
        \u043F\u0438\u0448\u0435\u0442 \u0432\u044B\u0433\u043E\u0432\u043E\u0440."
      knowledgeChange: -10
      friendshipChange: -20
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 2
    checkThreshold: 40
