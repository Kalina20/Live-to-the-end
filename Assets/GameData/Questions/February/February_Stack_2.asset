  m_Name: February_Stack_2
  m_EditorClassIdentifier: Assembly-CSharp::QuestionSet
  monthName: February
  stackNumber: 2
  questions:
  - questionText: "\u041A\u0430\u0444\u0435\u0434\u0440\u0430 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442
      \u0442\u0435\u043C\u044B \u043A\u0443\u0440\u0441\u043E\u0432\u044B\u0445 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0432
      \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u0441\u0435\u043C\u0435\u0441\u0442\u0440."
    answers:
    - answerText: "\u0417\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u0442\u043E\u043F\u043E\u0432\u0443\u044E
        \u0442\u0435\u043C\u0443 \u043F\u043E Android."
      knowledgeChange: 20
      friendshipChange: 0
      moneyChange: 0
    - answerText: "\u0412\u0430\u043C \u0434\u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F
        \u0443\u043D\u044B\u043B\u0430\u044F \u0440\u0443\u0442\u0438\u043D\u0430
        \u043F\u043E \u0413\u041E\u0421\u0422\u0430\u043C."
      knowledgeChange: -15
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 1
    checkThreshold: 40
  - questionText: "\u0422\u043E\u0432\u0430\u0440\u0438\u0449\u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u044E\u0442
      \u0437\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u0443\u044E \u043F\u043E\u0435\u0437\u0434\u043A\u0443
      \u043D\u0430 \u0431\u0430\u0437\u0443 \u043E\u0442\u0434\u044B\u0445\u0430
      \u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435."
    answers:
    - answerText: "\u0412\u0430\u0441 \u0437\u043E\u0432\u0443\u0442 \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
        \u0441\u043E\u0441\u0442\u0430\u0432, \u0432\u044B\u0448\u043B\u043E \u0434\u0435\u0448\u0435\u0432\u043E."
      knowledgeChange: 0
      friendshipChange: 25
      moneyChange: -2000
    - answerText: "\u0417\u043E\u0432\u0443\u0442 \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u043C\u043E\u043C\u0435\u043D\u0442 \u043F\u043E \u04452 \u043F\u0440\u0430\u0439\u0441\u0443."
      knowledgeChange: 0
      friendshipChange: -10
      moneyChange: -5000
    isCheckEvent: 1
    statToCheck: 2
    checkThreshold: 40
  - questionText: "\u041B\u043E\u043C\u0430\u0435\u0442\u0441\u044F \u0431\u043B\u043E\u043A
      \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u0432\u0430\u0448\u0435\u0433\u043E
      \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E \u0440\u0430\u0431\u043E\u0447\u0435\u0433\u043E
      \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430."
    answers:
    - answerText: "\u041F\u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0435 \u043D\u043E\u0432\u044B\u0439
        \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
        \u0431\u043B\u043E\u043A \u043F\u0438\u0442\u0430\u043D\u0438\u044F."
      knowledgeChange: 0
      friendshipChange: 0
      moneyChange: -4000
    - answerText: "\u041A\u043E\u043C\u043F \u0441\u0442\u043E\u0438\u0442 \u043C\u0435\u0440\u0442\u0432\u044B\u043C,
        \u043B\u0430\u0431\u044B \u0434\u0435\u043B\u0430\u0442\u044C \u043D\u0435
        \u043D\u0430 \u0447\u0435\u043C."
      knowledgeChange: -20
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 3
    checkThreshold: 12000
  - questionText: "\u041D\u0430 \u043A\u0430\u0444\u0435\u0434\u0440\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442
      \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432 \u0434\u043B\u044F \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E\u0439
      \u043F\u043E\u0435\u0437\u0434\u043A\u0438 \u043D\u0430 \u0418\u0422-\u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0443."
    answers:
    - answerText: "\u0412\u0430\u0441 \u0431\u0435\u0440\u0443\u0442 \u0437\u0430
        \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u043C\u043E\u0441\u0442\u044C."
      knowledgeChange: 15
      friendshipChange: 0
      moneyChange: 0
    - answerText: "\u041E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u0443\u0447\u0438\u0442\u044C\u0441\u044F
        \u0432 \u041C\u043E\u0441\u043A\u0432\u0435."
      knowledgeChange: -5
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 1
    checkThreshold: 45
