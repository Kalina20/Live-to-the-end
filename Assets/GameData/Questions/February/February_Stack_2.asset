  questions:
  - questionText: "\u0412\u044B \u043F\u0440\u043E\u0441\u043F\u0430\u043B\u0438
      \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u0435 \u043F\u043E \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044E
      \u043F\u0440\u0430\u043A\u0442\u0438\u043A, \u0438 \u0432\u0430\u043C \u0434\u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u0441\u0430\u043C\u043E\u0435 \u0445\u0443\u0434\u0448\u0435\u0435 \u0438
      \u0443\u043D\u044B\u043B\u043E\u0435 \u043C\u0435\u0441\u0442\u043E."
    answers:
    - answerText: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
        \u043E \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0435"
      knowledgeChange: 0
      friendshipChange: 5
      moneyChange: -2000
    - answerText: "\u0421\u043C\u0438\u0440\u0438\u0442\u044C\u0441\u044F \u0438
        \u0441\u0442\u0440\u0430\u0434\u0430\u0442\u044C"
      knowledgeChange: -15
      friendshipChange: -5
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u041D\u0430 \u043A\u0430\u043D\u0438\u043A\u0443\u043B\u0430\u0445
      \u0432\u044B \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u043D\u043E\u0433\u043E, \u0438 \u043D\u0430 \u0431\u0430\u043B\u0430\u043D\u0441\u0435
      \u043A\u0430\u0440\u0442\u044B \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u044B\u0439
      \u043D\u043E\u043B\u044C."
    answers:
    - answerText: "\u041F\u0440\u043E\u0441\u0438\u0442\u044C \u0443 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439"
      knowledgeChange: 0
      friendshipChange: -5
      moneyChange: -5000
    - answerText: "\u0421\u0435\u0441\u0442\u044C \u043D\u0430 \u0436\u0435\u0441\u0442\u043A\u0443\u044E
        \u0434\u0438\u0435\u0442\u0443"
      knowledgeChange: -10
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u041A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043D\u044B\u0439
      \u0432\u0438\u0440\u0443\u0441 \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043B
      \u0432\u0441\u0435 \u0432\u0430\u0448\u0438 \u0438\u0441\u0445\u043E\u0434\u043D\u0438\u043A\u0438
      \u043F\u043E \u043A\u0443\u0440\u0441\u043E\u0432\u043E\u0439, \u0431\u044D\u043A\u0430\u043F\u043E\u0432
      \u043D\u0430 GitHub \u043D\u0435 \u0431\u044B\u043B\u043E."
    answers:
    - answerText: "\u041A\u0443\u043F\u0438\u0442\u044C \u0443\u0442\u0438\u043B\u0438\u0442\u0443
        \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0438"
      knowledgeChange: 5
      friendshipChange: 0
      moneyChange: -3000
    - answerText: "\u041F\u0438\u0441\u0430\u0442\u044C \u0432\u0441\u0451 \u0437\u0430\u043D\u043E\u0432\u043E
        \u0441 \u043D\u0443\u043B\u044F"
      knowledgeChange: -15
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0418\u0437-\u0437\u0430 \u0441\u0438\u043B\u044C\u043D\u044B\u0445
      \u043C\u043E\u0440\u043E\u0437\u043E\u0432 \u0432 \u043E\u0431\u0449\u0430\u0433\u0435
      \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u043B\u0438 \u043E\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u0435.
      \u0421\u0438\u0434\u0435\u0442\u044C \u0437\u0430 \u043D\u043E\u0443\u0442\u043E\u043C
      \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u2014 \u0437\u0430\u043C\u0435\u0440\u0437\u0430\u044E\u0442
      \u043F\u0430\u043B\u044C\u0446\u044B."
    answers:
    - answerText: "\u041A\u0443\u043F\u0438\u0442\u044C \u043E\u0431\u043E\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043B\u044C
        \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443"
      knowledgeChange: 0
      friendshipChange: 10
      moneyChange: -2500
    - answerText: "\u0423\u0435\u0445\u0430\u0442\u044C \u0433\u0440\u0435\u0442\u044C\u0441\u044F
        \u043A \u0434\u0440\u0443\u0437\u044C\u044F\u043C"
      knowledgeChange: -15
      friendshipChange: 10
      moneyChange: -1000
    isCheckEvent: 0
