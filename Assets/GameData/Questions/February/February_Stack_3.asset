  questions:
  - questionText: "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0441 \u043A\u0430\u043D\u0438\u043A\u0443\u043B. \u041F\u0440\u0438\u0432\u0435\u0437
      \u043F\u043E\u043B\u043D\u0443\u044E \u0441\u0443\u043C\u043A\u0443 \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0439
      \u0435\u0434\u044B \u0438 \u0437\u0430\u043A\u0440\u0443\u0442\u043E\u043A,
      \u0434\u0440\u0443\u0437\u044C\u044F \u0443\u0436\u0435 \u0441\u0431\u0435\u0433\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0445."
    answers:
    - answerText: "\u041D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C \u0432\u0441\u0435\u0445"
      knowledgeChange: 0
      friendshipChange: 20
      moneyChange: -1500
    - answerText: "\u0421\u044A\u0435\u0441\u0442\u044C \u0432\u0441\u0435 \u0441\u0430\u043C\u043E\u043C\u0443"
      knowledgeChange: 0
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0412\u044B\u0431\u043E\u0440 \u0442\u0435\u043C\u044B \u0434\u043B\u044F
      \u043A\u0443\u0440\u0441\u043E\u0432\u043E\u0439: \u0432\u0437\u044F\u0442\u044C
      \u0445\u0430\u0440\u0434\u043A\u043E\u0440\u043D\u0443\u044E \u0442\u0435\u043C\u0443
      \u043F\u043E \u043C\u0430\u0448\u0438\u043D\u043D\u043E\u043C\u0443 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044E
      \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u0443\u044E \u0431\u0430\u0437\u0443
      \u0434\u0430\u043D\u043D\u044B\u0445 \u0434\u043B\u044F \u0433\u0430\u043B\u043E\u0447\u043A\u0438."
    answers:
    - answerText: "\u0412\u0437\u044F\u0442\u044C \u0441\u043B\u043E\u0436\u043D\u0443\u044E"
      knowledgeChange: 25
      friendshipChange: -5
      moneyChange: 0
    - answerText: "\u0412\u0437\u044F\u0442\u044C \u0445\u0430\u043B\u044F\u0432\u043D\u0443\u044E"
      knowledgeChange: -10
      friendshipChange: 10
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u0414\u0435\u043D\u044C \u0441\u0432\u044F\u0442\u043E\u0433\u043E
      \u0412\u0430\u043B\u0435\u043D\u0442\u0438\u043D\u0430. \u041D\u0443\u0436\u043D\u043E
      \u0440\u0435\u0448\u0438\u0442\u044C, \u0442\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F
      \u043B\u0438 \u043D\u0430 \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u0438
      \u043A\u0438\u043D\u043E, \u0438\u043B\u0438 \u043F\u0440\u043E\u0438\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A."
    answers:
    - answerText: "\u041F\u043E\u0439\u0442\u0438 \u043D\u0430 \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u0435"
      knowledgeChange: -5
      friendshipChange: 15
      moneyChange: -3000
    - answerText: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C"
      knowledgeChange: 10
      friendshipChange: -5
      moneyChange: 0
    isCheckEvent: 0
    statToCheck: 0
    checkThreshold: 0
  - questionText: "\u041E\u0434\u043D\u043E\u0433\u0440\u0443\u043F\u043F\u043D\u0438\u043A\u0438
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E\u0442 \u0440\u0430\u0441\u0448\u0430\u0440\u0438\u0442\u044C
      \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043F\u043B\u0430\u0442\u043D\u0443\u044E \u043F\u0440\u0435\u043C\u0438\u0443\u043C-\u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0443
      \u043D\u0430 \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0439
      \u0441\u0435\u0440\u0432\u0438\u0441."
