  m_Script: {fileID: 11500000, guid: 5e5612d4c1ab8054f975222f7e4b0a9b, type: 3}
  m_Name: November_Stack_2
  m_EditorClassIdentifier: Assembly-CSharp::QuestionSet
  monthName: November
  stackNumber: 2
  questions:
  - questionText: "\u0412\u044B \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438
      \u043D\u0430\u0447\u0435\u0440\u0442\u0438\u0442\u044C \u0441\u0445\u0435\u043C\u0443
      \u043F\u043E \u0438\u043D\u0436\u0433\u0440\u0430\u0444\u0443, \u0430 \u043F\u0430\u0440\u0430
      \u0443\u0436\u0435 \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441."
    answers:
    - answerText: "\u041E\u0434\u043D\u043E\u0433\u0440\u0443\u043F\u043F\u043D\u0438\u043A\u0438
        \u0434\u0430\u043B\u0438 \u0441\u0432\u043E\u0439 \u0447\u0435\u0440\u0442\u0435\u0436
        \u0434\u043B\u044F \u043A\u043E\u043F\u0438\u0438."
      knowledgeChange: 10
      friendshipChange: 5
      moneyChange: 0
    - answerText: "\u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u043C\u043E\u0433,
        \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435 \u043D\u0435\u0434\u043E\u043F\u0443\u0441\u043A."
      knowledgeChange: -5
      friendshipChange: -15
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 2
    checkThreshold: 25
  - questionText: "\u0418\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F IT-\u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u043E\u0442\u0431\u043E\u0440
      \u043D\u0430 \u0437\u0438\u043C\u043D\u044E\u044E \u0441\u0442\u0430\u0436\u0438\u0440\u043E\u0432\u043A\u0443."
    answers:
    - answerText: "\u041F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0435 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435
        \u0438\u043D\u0442\u0435\u0440\u0432\u044C\u044E \u043D\u0430 \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u044B."
      knowledgeChange: 10
      friendshipChange: 0
      moneyChange: 12000
    - answerText: "\u0417\u0430\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C \u043D\u0430
        \u0432\u043E\u043F\u0440\u043E\u0441\u0435 \u043F\u0440\u043E \u0441\u0442\u0435\u043A
        \u0438 \u043A\u0443\u0447\u0443."
      knowledgeChange: -5
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 1
    checkThreshold: 30
  - questionText: "\u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u044B
      \u0445\u0430\u043A\u0430\u0442\u043E\u043D\u0430 \u0442\u0440\u0435\u0431\u0443\u044E\u0442
      \u043E\u0440\u0433\u0432\u0437\u043D\u043E\u0441 \u0437\u0430 \u0443\u0447\u0430\u0441\u0442\u0438\u0435
      \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u0432 \u0444\u0438\u043D\u0430\u043B\u0435."
    answers:
    - answerText: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u043F\u043B\u0430\u0442\u0438\u0442\u0435
        \u0432\u0437\u043D\u043E\u0441 \u0437\u0430 \u0441\u0435\u0431\u044F \u0438
        \u0434\u0440\u0443\u0433\u0430."
      knowledgeChange: 10
      friendshipChange: 15
      moneyChange: -3000
    - answerText: "\u041F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0435
        \u0444\u0438\u043D\u0430\u043B \u0438\u0437-\u0437\u0430 \u043D\u0435\u0445\u0432\u0430\u0442\u043A\u0438
        \u0431\u044E\u0434\u0436\u0435\u0442\u0430."
      knowledgeChange: -5
      friendshipChange: -10
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 3
    checkThreshold: 10000
  - questionText: "\u041A\u043E\u043D\u0444\u043B\u0438\u043A\u0442 \u0441\u043E
      \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u043E\u0439 \u0438\u0437-\u0437\u0430
      \u0432\u0430\u0448\u0438\u0445 \u0447\u0430\u0441\u0442\u044B\u0445 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u043E\u0432
      \u043B\u0435\u043A\u0446\u0438\u0439."
    answers:
    - answerText: "\u0421\u0442\u0430\u0440\u043E\u0441\u0442\u0430 \u043C\u043E\u043B\u0447\u0430
        \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0432\u0430\u0441
        \u043F\u0435\u0440\u0435\u0434 \u0434\u0435\u043A\u0430\u043D\u0430\u0442\u043E\u043C."
      knowledgeChange: 0
      friendshipChange: 15
      moneyChange: 0
    - answerText: "\u0412\u0430\u043C \u0441\u0442\u0430\u0432\u044F\u0442 \u043A\u0443\u0447\u0443
        \"\u043D-\u043E\u043A\", \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F."
      knowledgeChange: -10
      friendshipChange: -20
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 2
    checkThreshold: 30
