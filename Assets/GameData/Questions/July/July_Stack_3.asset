  m_Script: {fileID: 11500000, guid: 5e5612d4c1ab8054f975222f7e4b0a9b, type: 3}
  m_Name: July_Stack_3
  m_EditorClassIdentifier: Assembly-CSharp::QuestionSet
  monthName: July
  stackNumber: 3
  questions:
  - questionText: "\u0417\u0430\u0449\u0438\u0442\u0430 \u043E\u0442\u0447\u0435\u0442\u043E\u0432
      \u043F\u043E \u043B\u0435\u0442\u043D\u0435\u0439 \u043F\u0440\u043E\u0435\u043A\u0442\u043D\u043E\u0439
      \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0435."
    answers:
    - answerText: "\u0412\u0430\u0448\u0435 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
        \u0445\u0432\u0430\u043B\u044F\u0442, \u043E\u0442\u0447\u0435\u0442 \u043F\u0440\u0438\u043D\u044F\u0442."
      knowledgeChange: 20
      friendshipChange: 0
      moneyChange: 0
    - answerText: "\u041E\u0442\u0447\u0435\u0442 \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u043B\u0438
        \u0438\u0437-\u0437\u0430 \u043F\u043B\u043E\u0445\u043E\u0439 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u044B."
      knowledgeChange: -15
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 1
    checkThreshold: 60
  - questionText: "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442\u0441\u044F,
      \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043F\u043B\u043E\u0447\u0435\u043D\u043D\u043E\u0439
      \u0441\u0442\u0430\u043B\u0430 \u0432\u0430\u0448\u0430 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
      \u043A \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u043B\u0435\u0442\u0430."
    answers:
    - answerText: "\u0414\u0440\u0443\u0437\u044C\u044F \u0437\u043E\u0432\u0443\u0442
        \u0432 \u0442\u0440\u0438\u043F, \u0434\u0435\u043B\u044F \u0440\u0430\u0441\u0445\u043E\u0434\u044B
        \u043F\u043E\u0440\u043E\u0432\u043D\u0443."
      knowledgeChange: 0
      friendshipChange: 20
      moneyChange: -3000
    - answerText: "\u0412\u0430\u0441 \u043D\u0435 \u0431\u0435\u0440\u0443\u0442,
        \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0435 \u0438\u044E\u043B\u044C
        \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435."
      knowledgeChange: 0
      friendshipChange: -25
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 2
    checkThreshold: 55
  - questionText: "\u041D\u0430 \u043B\u0435\u0442\u043D\u0438\u0445 \u043A\u0430\u043D\u0438\u043A\u0443\u043B\u0430\u0445
      \u0440\u0435\u0437\u043A\u043E \u0434\u043E\u0440\u043E\u0436\u0430\u0435\u0442
      \u0430\u0440\u0435\u043D\u0434\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u043E\u0432
      \u0434\u043B\u044F \u0432\u0430\u0448\u0438\u0445 \u043B\u0438\u0447\u043D\u044B\u0445
      \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0432."
    answers:
    - answerText: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u043F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u0435\u0442\u0435
        \u0430\u0440\u0435\u043D\u0434\u0443 \u0445\u043E\u0441\u0442\u0438\u043D\u0433\u0430."
      knowledgeChange: 10
      friendshipChange: 0
      moneyChange: -4000
    - answerText: "\u0422\u0435\u0440\u044F\u0435\u0442\u0435 \u0432\u0441\u0435
        \u043D\u0430\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u0438 \u0441\u0435\u0440\u0432\u0435\u0440
        \u0437\u0430 \u0434\u043E\u043B\u0433\u0438."
      knowledgeChange: -20
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 3
    checkThreshold: 22000
  - questionText: "\u041B\u0435\u0442\u043D\u044F\u044F \u0448\u043A\u043E\u043B\u0430
      \u043E\u0442 \u042F\u043D\u0434\u0435\u043A\u0441\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442
      \u0436\u0435\u0441\u0442\u043A\u0438\u0439 \u0434\u043E\u0431\u043E\u0440 \u043F\u043E
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u043C \u0433\u043E\u0434\u0430."
    answers:
    - answerText: "\u0412\u0430\u0441 \u0437\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442
        \u043D\u0430 \u043A\u0440\u0443\u0442\u043E\u0439 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432."
      knowledgeChange: 25
      friendshipChange: 0
      moneyChange: 0
    - answerText: "\u041D\u0435 \u043F\u0440\u043E\u0448\u043B\u0438 \u043F\u043E
        \u043E\u0431\u0449\u0435\u043C\u0443 \u0440\u0435\u0439\u0442\u0438\u043D\u0433\u0443
        \u043E\u0446\u0435\u043D\u043E\u043A."
      knowledgeChange: -10
      friendshipChange: 0
      moneyChange: 0
    isCheckEvent: 1
    statToCheck: 1
    checkThreshold: 65
